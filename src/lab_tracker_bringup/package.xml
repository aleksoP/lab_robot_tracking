<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>lab_tracker_bringup</name>
  <version>0.1.0</version>
  <description>Launch files for the lab robot tracking system.</description>
  <maintainer email="aleksandrpustrom@gmail.com">aleks</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- Launch-time dependencies (nodes started by this package's launch files) -->
  <exec_depend>usb_cam</exec_depend>         <!-- kept so rosdep can install it -->
  <exec_depend>v4l2_camera</exec_depend>
  <exec_depend>v4l-utils</exec_depend>
  <exec_depend>image_proc</exec_depend>
  <exec_depend>apriltag_ros</exec_depend>
  <exec_depend>lab_tracker_fusion</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
